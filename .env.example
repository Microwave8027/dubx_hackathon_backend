# Server
PORT=3000
NODE_ENV=development
# Origin of your frontend (CORS + post-login redirect). 8080 = the example_ui server.
CLIENT_ORIGIN=http://localhost:8080

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/dubx

# Session cookie signing secret (use a long random string, e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Session cookies are `secure` (HTTPS only) when NODE_ENV=production. Set to false only to
# test the production container over plain http://localhost.
# COOKIE_SECURE=false

# Fallback IANA time zone when the request body doesn't include `timeZone`
DEFAULT_TIME_ZONE=UTC

# Minutes before a block starts that /blocks/stream sends its "coming up" prompt
REMINDER_LEAD_MINUTES=5
# Days ahead POST /blocks/sync pulls from Google Calendar when the body has no `to`
SYNC_DAYS_AHEAD=14
