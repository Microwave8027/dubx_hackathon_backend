{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Center",
  "version": "0.1.0",
  "identifier": "com.micro.dubx-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Command Center",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      },
      {
        "label": "widget",
        "title": "Command Center Widget",
        "url": "/widget",
        "width": 96,
        "height": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
