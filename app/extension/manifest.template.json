{
  "manifest_version": 3,
  "name": "Command Center Tab Sync",
  "version": "0.1.0",
  "description": "When you save your config in Command Center, this browser sends its open tabs to your account.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["__APP_ORIGIN__/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Command Center Tab Sync", "default_popup": "popup.html" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "externally_connectable": { "matches": ["__APP_ORIGIN__/*"] },
  "incognito": "not_allowed"
}
