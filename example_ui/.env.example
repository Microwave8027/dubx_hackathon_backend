# Where this UI server listens
UI_HOST=127.0.0.1
UI_PORT=8080

# How this server reaches the Express backend (server-to-server)
BACKEND_URL=http://localhost:3000

# How the browser reaches the backend (target of the "Sign in with Google" link).
# Defaults to BACKEND_URL; set it if the two differ (e.g. BACKEND_URL=http://app:3000 in Docker).
# BACKEND_PUBLIC_URL=http://localhost:3000
